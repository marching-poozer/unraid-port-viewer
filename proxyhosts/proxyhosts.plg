<?xml version='1.0' standalone='yes'?>

<!DOCTYPE PLUGIN [
<!ENTITY name      "proxyhosts">
<!ENTITY author    "poozer">
<!ENTITY version   "2026.11.08">
<!ENTITY md5       "a686013515ee9a45ec0ee197531074ea">
<!ENTITY pkg       "&name;-&version;-noarch-1">
<!ENTITY launch    "Settings/ProxyHostsSettings">
<!ENTITY repo      "https://raw.githubusercontent.com/marching-poozer/unraid-port-viewer/main/proxyhosts">
<!ENTITY plgPATH   "/boot/config/plugins/&name;">
<!ENTITY emhttp    "/usr/local/emhttp/plugins/&name;">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;"
        pluginURL="&repo;/proxyhosts.plg"
        icon="proxyhosts.png"
        min="7.0.0"
        comment="Adds an Add / Edit Proxy Host control to each Docker container to create and manage its Nginx Proxy Manager host (and optional Pi-hole CNAME)."
        support="https://github.com/marching-poozer/unraid-port-viewer">

<CHANGES>
Manages Nginx Proxy Manager (NPM) proxy hosts from the Docker tab. Each
container gets an Add / Edit Proxy Host control under its name; optionally
keeps a matching Pi-hole CNAME in sync for every domain too.

Highlights
- Create a proxy host for a container from a small form: domain, an existing
  certificate (an exact or one-level wildcard match is picked for you), Force
  SSL and websocket upgrade. Certificates are reused, never requested.
- Edit it later: add, remove, pause or resume individual domains, disable or
  enable the whole host, or delete it.
- Can forward straight to the container's name and port when it shares a
  Docker network with NPM, instead of the LAN-published port.
- Hosts made in NPM by hand are recognised by where they forward to.
- All NPM and Pi-hole calls are made by the Unraid server (curl), so there is
  no CORS or per-browser setup; settings live under Settings -&gt; Network
  Services -&gt; Proxy Hosts and are shared by every user of the web UI.

###2026.11.08
- Moved into the combined plugins repository (marching-poozer/unraid-port-viewer).
  The update URL changed. Package rebuilt from the current source.

###2026.10.03
- Initial scaffold, ported from the "NPM Proxy Helper" browser extension.
</CHANGES>

<!-- Pre-install cleanup: remove any prior proxyhosts packages and clear the
     install dir so stale .page files from earlier versions don't register
     duplicate menu entries. Safe to re-run. -->
<FILE Run="/bin/bash">
<INLINE>
for pkg in /var/log/packages/&name;-*; do
  [ -f "$pkg" ] || continue
  removepkg "$(basename "$pkg")" 2&gt;/dev/null || true
done
rm -rf &emhttp;
</INLINE>
</FILE>

<FILE Name="&plgPATH;/&pkg;.txz">
<URL>&repo;/archive/&pkg;.txz</URL>
<MD5>&md5;</MD5>
</FILE>

<FILE Run="upgradepkg --install-new">
<LOCAL>&plgPATH;/&pkg;.txz</LOCAL>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
for pkg in /var/log/packages/&name;-*; do
  [ -f "$pkg" ] || continue
  removepkg "$(basename "$pkg")" 2&gt;/dev/null || true
done
rm -rf &emhttp;
rm -rf &plgPATH;
</INLINE>
</FILE>

</PLUGIN>
